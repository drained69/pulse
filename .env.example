# ── QIE Pulse server configuration ──
# Copy to .env and fill in. Every value has a safe default except the ones marked REQUIRED IN PRODUCTION.

# Network: mainnet (chain 1990) or testnet (chain 1983)
QIE_NETWORK=mainnet
# Comma-separated RPCs. Default: rpc1..rpc5mainnet.qie.digital
# RPC_URLS=https://rpc1mainnet.qie.digital,https://rpc2mainnet.qie.digital

# REQUIRED IN PRODUCTION: the public URL people open (used in sign-in messages and cookie security)
PUBLIC_URL=http://localhost:8787
PORT=8787
DB_PATH=./qiepulse.db

# Blocks to wait behind the head. QIE has instant finality (CometBFT), so 1 is plenty.
CONFIRMATIONS=1
# Where a fresh database starts indexing: "latest" or a block number
START_BLOCK=latest

# ── Telegram (optional but recommended) ──
# Create a bot with @BotFather, paste its token here.
TELEGRAM_BOT_TOKEN=
# Optional: public feed of large QUSDC transfers. Add the bot as admin to a channel and put its id (e.g. -1001234567890) or @username here.
PUBLIC_ALERTS_CHAT_ID=
PUBLIC_ALERTS_MIN_QUSDC=1000

# ── Billing (optional) ──
# Address of QieHooksBilling on QIE (see contracts/README). Leave empty to run free-only.
BILLING_CONTRACT=
PRO_PRICE_QUSDC=9
PRO_PERIOD_DAYS=30

# ── Plan limits ──
FREE_MAX_HOOKS=10
FREE_MONTHLY_EVENTS=5000
PRO_MAX_HOOKS=100
PRO_MONTHLY_EVENTS=200000

# Development only: allow webhooks to localhost/private IPs
ALLOW_PRIVATE_WEBHOOKS=false
# Header your reverse proxy sets to the real client IP, for rate limits (e.g. x-forwarded-for, x-real-ip).
# Only set it behind a proxy that overwrites the header. Defaults to fly-client-ip on Fly.io.
# CLIENT_IP_HEADER=
# Extra origins allowed to call the API with a session cookie (Vite dev server)
DEV_ORIGINS=http://localhost:5173

# Days of event history to keep (deliveries are deleted with their events)
EVENT_RETENTION_DAYS=30
