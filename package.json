{
  "name": "q-pulse",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time webhooks, Telegram and Discord alerts, payment links and provable traction for QIE Blockchain",
  "license": "MIT",
  "homepage": "https://qpulsev1.up.railway.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drained69/pulse.git"
  },
  "bugs": {
    "url": "https://github.com/drained69/pulse/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:contracts",
    "test:contracts": "cd contracts && forge test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "bash scripts/e2e-fork.sh",
    "verify-traction": "node apps/server/bin/verify-traction.ts",
    "start": "pnpm --filter @qpulse/server start"
  },
  "packageManager": "pnpm@9.0.0"
}
